# Supabase project (Settings -> API in the Supabase dashboard).
# The app runs in demo mode with mock data until these are set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Server-only — never prefix with NEXT_PUBLIC_, never send
# to the browser. Used only by src/lib/supabase/admin.ts for privileged
# server-side operations (e.g. admin user management).
SUPABASE_SERVICE_ROLE_KEY=

# Used to build the email confirmation redirect link. Set to your deployed
# URL in production (e.g. https://tradeintel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
